# Razorpay AI Finance Controller - Cloud Environment Variables
APP_NAME="Razorpay AI Finance Controller"
ENVIRONMENT="production"
PORT=8000
HOST="0.0.0.0"

# AI Model Provider: "fallback" (deterministic zero-dependency), "gemini", or "openai"
LLM_PROVIDER="fallback"

# Optional API Keys for Live Cloud LLM Anomaly Reasoning
# GEMINI_API_KEY="AIzaSy..."
# OPENAI_API_KEY="sk-..."

# Audit Trail Security Key
AUDIT_SECRET_SALT="razorpay_ai_controller_audit_salt_2026"
